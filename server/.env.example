# Copy to server/.env and fill in. Never commit .env.

# Port and host the gateway listens on.
PORT=3000
HOST=127.0.0.1

# Your own DeepSeek API key. End users never see this value.
DEEPSEEK_API_KEY=

# Where model traffic is forwarded. Defaults to the DeepSeek API.
UPSTREAM_BASE_URL=https://api.deepseek.com

# Per-user daily request cap (0 disables the check).
DAILY_LIMIT=200

# SQLite database file, relative to the server directory.
DB_PATH=data/mareo.db


# --- Email verification code delivery (Feishu/Lark SMTP) ---
# 未配置时：本地/测试走日志模式；生产环境发送会返回错误（不影响 token 登录）。
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@mareo.ai
SMTP_PASS=
SMTP_FROM=no-reply@mareo.ai

# Example nginx site config for the Mareo gateway (Aliyun free SSL certificate,
# nginx format). Replace api.mareo.cn with your real domain and point the cert
# paths at your certificate files. Install at /etc/nginx/conf.d/mareo-gateway.conf.

server {
    listen 80;
    server_name api.mareo.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.mareo.cn;

    ssl_certificate     /etc/nginx/certs/api.mareo.cn.pem;
    ssl_certificate_key /etc/nginx/certs/api.mareo.cn.key;

    # Image uploads can be a few MB.
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Model responses stream (SSE): never buffer, and allow long-lived
        # connections far beyond nginx's 60s default.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Mareo 官网 nginx 配置示例（mareo.cn 大陆站，与网关同 ECS）
# 安装到服务器 /etc/nginx/conf.d/mareo-site.conf 前：
#   1) DNS 添加 A 记录：mareo.cn 和 www.mareo.cn → ECS 公网 IP
#   2) 证书放到 /etc/nginx/certs/mareo.cn.{pem,key}（阿里云免费证书或 Let's Encrypt）
#   3) 代码放到 /var/www/mareo-site

server {
    listen 80;
    server_name mareo.cn www.mareo.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name mareo.cn www.mareo.cn;

    ssl_certificate     /etc/nginx/certs/mareo.cn.pem;
    ssl_certificate_key /etc/nginx/certs/mareo.cn.key;

    root /var/www/mareo-site;
    index index.html;

    # 静态资源长缓存（logo/css/js/favicon 都带版本后缀时可开）
    location ~* \.(css|js|png|ico)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location /downloads/ {
        # 大文件下载不断流
        sendfile on;
        tcp_nopush on;
    }
}
